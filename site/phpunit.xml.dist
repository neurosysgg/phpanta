<?xml version="1.0" encoding="UTF-8"?>
<!--
  The site's own suite, under the site's own app: every page, at every address, in every language.
  The framework's suite cannot run these — it boots TestApp, and one app is all a process holds.
  Run it after `npm run site:build`, which writes the AssetManifest the shell reads.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="test/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="site">
            <directory>test</directory>
        </testsuite>
    </testsuites>
</phpunit>
