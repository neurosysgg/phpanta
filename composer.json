{
    "name": "neurosysgg/phpanta",
    "description": "A small full-stack web framework for plain PHP 8.5 and browser-native TypeScript.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://neurosysgg.github.io/phpanta/",
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-openssl": "*",
        "ext-uri": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Phpanta\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "test": "The framework's own suite, under TestApp"
    },
    "config": {
        "sort-packages": true
    }
}
